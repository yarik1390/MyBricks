{
  "name": "mybricks-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "cmd /c \"npm --prefix worker install\"",
    "typecheck": "cmd /c \"npm --prefix worker run typecheck\"",
    "test": "node scripts/check-ui-strings.mjs && node scripts/check-i18n-dynamic-sinks.mjs && node scripts/verify-ui-dicts.mjs && node --test public/js/__tests__/pure.test.js",
    "lint": "biome lint",
    "status": "git status",
    "a11y": "playwright test --config=a11y/playwright.config.mjs",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun --config=a11y/lighthouserc.json",
    "e2e": "playwright test --config=e2e/playwright.config.mjs",
    "android:assetlinks": "node scripts/configure-assetlinks.mjs",
    "android:preflight": "node scripts/android-release-preflight.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.61.1"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^13.2.2",
    "@revenuecat/purchases-capacitor-ui": "^13.2.2"
  }
}
