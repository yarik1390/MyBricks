{
  "name": "mybricks-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "cmd /c \"npm --prefix worker install\"",
    "typecheck": "cmd /c \"npm --prefix worker run typecheck\"",
    "test": "node --test public/js/__tests__/pure.test.js",
    "lint": "biome lint",
    "status": "git status",
    "a11y": "playwright test --config=a11y/playwright.config.mjs",
    "lhci": "lhci autorun --config=a11y/lighthouserc.json",
    "e2e": "playwright test --config=e2e/playwright.config.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.61.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@revenuecat/purchases-capacitor": "^13.2.2",
    "@revenuecat/purchases-capacitor-ui": "^13.2.2"
  }
}
