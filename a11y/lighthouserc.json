{
  "ci": {
    "collect": {
      "url": [
        "https://bricksvault.app/",
        "https://bricksvault.app/#/build"
      ],
      "numberOfRuns": 1,
      "settings": { "onlyCategories": ["accessibility"] }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
