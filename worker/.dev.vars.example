# OpenAI API Key (Required for GPT-4o barcode identification & GPT-4o-mini valuations)
OPENAI_API_KEY=your_openai_api_key_here

# Rebrickable API Key (Optional, unlocks catalog lookup fallback if not in local cache)
REBRICKABLE_API_KEY=your_rebrickable_api_key_here

# Supabase Auth Configuration (Required for login & collections sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
ADMIN_USER_ID=your_supabase_admin_user_uuid_here

# Brickset API Key (Optional)
BRICKSET_API_KEY=your_brickset_api_key_here

# BrickLink OAuth Credentials (Optional)
BRICKLINK_CONSUMER_KEY=your_key
BRICKLINK_CONSUMER_SECRET=your_secret
BRICKLINK_TOKEN=your_token
BRICKLINK_TOKEN_SECRET=your_token_secret

# Google OAuth Credentials (Optional, required for Google Sheets sync)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Pricing and barcode providers (Optional)
EBAY_APP_ID=your_ebay_production_app_id_or_client_id
EBAY_CLIENT_SECRET=your_matching_ebay_production_cert_id_or_client_secret
BRICKECONOMY_API_KEY=your_brickeconomy_api_key
BRICKOWL_API_KEY=your_brickowl_api_key
APIFY_API_TOKEN=

# Investment pricing rollout and PriceCharting quarantine
PRICING_V3_READ_PERCENT=0
PRICECHARTING_VERIFIED_ENABLED=0

# Amazon Associates (Phase A: Web link-only)
AMAZON_PARTNER_TAG_FR_WEB=your_web_tracking_id
AMAZON_PARTNER_TAG_FR_ANDROID=your_android_tracking_id
AMAZON_DEFAULT_MARKET=FR
AMAZON_WEB_ENABLED=0
AMAZON_ANDROID_ENABLED=0
# Phase B only after Creators API + mobile-app approval
AMAZON_CREATORS_PUBLIC_KEY=your_creators_public_key
AMAZON_CREATORS_PRIVATE_KEY=your_creators_private_key
AMAZON_CREATORS_ENABLED=0

# Optional server-side AI fallback. BYOK browser keys work without this.
GEMINI_API_KEY=your_gemini_api_key

# Optional wishlist notifications
RESEND_API_KEY=your_resend_api_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"your-project","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
