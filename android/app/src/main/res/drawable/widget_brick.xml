    <path android:fillColor="#F7C600"
        android:strokeColor="#26231D"
        android:strokeWidth="2"
        android:pathData="M14,11 m-5,-3 a5,3 0 1,0 10,0 a5,3 0 1,0 -10,0" />
    <path android:fillColor="#F7C600"
        android:strokeColor="#26231D"
        android:strokeWidth="2"
        android:pathData="M34,11 m-5,-3 a5,3 0 1,0 10,0 a5,3 0 1,0 -10,0" />
