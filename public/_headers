# Accepted risk (security review 2026-10-26): style-src keeps 'unsafe-inline'
# because views render ~470 inline style="" attributes; script-src has no
# 'unsafe-inline', so injected markup still can't run script. The two AI hosts
# in connect-src are only used to test a user's OWN key (Profile > Integrations);
# no server key is ever sent to the browser. Pages adds a wildcard
# Access-Control-Allow-Origin by default; the "!" line below removes it.
/*
  ! Access-Control-Allow-Origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self' https://cdn.jsdelivr.net https://challenges.cloudflare.com https://static.cloudflareinsights.com 'wasm-unsafe-eval'; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' blob: https://brickvault-api.zhydenko.workers.dev https://cdn.rebrickable.com https://*.supabase.co https://www.ebay.com https://open.er-api.com https://huggingface.co https://*.huggingface.co https://hf.co https://*.hf.co https://cdn.jsdelivr.net https://generativelanguage.googleapis.com https://api.openai.com https://challenges.cloudflare.com https://cloudflareinsights.com; frame-ancestors 'none'; upgrade-insecure-requests

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
